{
  "$schema": "https://typedoc.org/schema.json",
  // Validation only. starlight-typedoc generates the published reference but
  // never calls app.validate(), and typedoc enforces treatWarningsAsErrors
  // only in its CLI, so the undocumented-export gate has to be its own run.
  "entryPoints": [
    "src/index.ts",
    "src/bloom/index.ts",
    "src/blocked/index.ts",
    "src/fuse/index.ts",
    "src/hll/index.ts"
  ],
  "tsconfig": "./tsconfig.json",
  "readme": "none",
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notDocumented": true,
    "notExported": false,
    "invalidLink": true
  }
}

{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/bloom/index.ts",
    "src/blocked/index.ts",
    "src/fuse/index.ts"
  ],
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "formatWithPrettier": true,
  "tsconfig": "./tsconfig.json",
  "readme": "none",
  "hideGenerator": true,
  "gitRevision": "main",
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notDocumented": true,
    "notExported": false,
    "invalidLink": true
  }
}

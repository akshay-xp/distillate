{
  "name": "distillate",
  "version": "0.12.0",
  "description": "Probabilistic data structures for JavaScript. Space-efficient, approximate-membership filters (Bloom, Blocked Bloom, Binary Fuse) with tunable error and a portable binary format; zero dependencies, universal.",
  "keywords": [
    "bloom-filter",
    "cuckoo-filter",
    "binary-fuse",
    "xor-filter",
    "amq",
    "approximate-membership",
    "probabilistic",
    "probabilistic-data-structures",
    "set",
    "filter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshay-xp/distillate.git"
  },
  "homepage": "https://distillate.akxp.net",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bloom": {
      "types": {
        "import": "./dist/bloom/index.d.ts",
        "require": "./dist/bloom/index.d.cts"
      },
      "import": "./dist/bloom/index.js",
      "require": "./dist/bloom/index.cjs"
    },
    "./blocked": {
      "types": {
        "import": "./dist/blocked/index.d.ts",
        "require": "./dist/blocked/index.d.cts"
      },
      "import": "./dist/blocked/index.js",
      "require": "./dist/blocked/index.cjs"
    },
    "./fuse": {
      "types": {
        "import": "./dist/fuse/index.d.ts",
        "require": "./dist/fuse/index.d.cts"
      },
      "import": "./dist/fuse/index.js",
      "require": "./dist/fuse/index.cjs"
    },
    "./hll": {
      "types": {
        "import": "./dist/hll/index.d.ts",
        "require": "./dist/hll/index.d.cts"
      },
      "import": "./dist/hll/index.js",
      "require": "./dist/hll/index.cjs"
    },
    "./frame": {
      "types": {
        "import": "./dist/frame/index.d.ts",
        "require": "./dist/frame/index.d.cts"
      },
      "import": "./dist/frame/index.js",
      "require": "./dist/frame/index.cjs"
    },
    "./scalable": {
      "types": {
        "import": "./dist/scalable/index.d.ts",
        "require": "./dist/scalable/index.d.cts"
      },
      "import": "./dist/scalable/index.js",
      "require": "./dist/scalable/index.cjs"
    },
    "./cuckoo": {
      "types": {
        "import": "./dist/cuckoo/index.d.ts",
        "require": "./dist/cuckoo/index.d.cts"
      },
      "import": "./dist/cuckoo/index.js",
      "require": "./dist/cuckoo/index.cjs"
    },
    "./countmin": {
      "types": {
        "import": "./dist/countmin/index.d.ts",
        "require": "./dist/countmin/index.d.cts"
      },
      "import": "./dist/countmin/index.js",
      "require": "./dist/countmin/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "publint": "publint --strict",
    "check": "publint --strict && attw --pack . --profile node16",
    "attw": "attw --pack . --profile node16",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "api:report": "node scripts/api-extractor.mjs --local",
    "api:check": "node scripts/api-extractor.mjs",
    "docs:check": "typedoc --emit none",
    "golden:gen": "tsx scripts/gen-golden.ts",
    "size:check": "node scripts/size-check.mjs",
    "bench": "tsx bench/core.bench.ts && tsx bench/bloom.bench.ts && tsx bench/blocked.bench.ts && tsx bench/fuse.bench.ts && tsx bench/hll.bench.ts && tsx bench/accuracy.bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.1",
    "mitata": "^1.0.34",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "siftr",
  "version": "0.0.0",
  "description": "Modern approximate-membership toolkit for JavaScript. The next-generation successor to Bloom filter packages.",
  "keywords": [
    "bloom-filter",
    "cuckoo-filter",
    "binary-fuse",
    "xor-filter",
    "amq",
    "approximate-membership",
    "probabilistic",
    "set",
    "filter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshay-xp/siftr.git"
  },
  "homepage": "https://github.com/akshay-xp/siftr#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bloom": {
      "types": {
        "import": "./dist/bloom/index.d.ts",
        "require": "./dist/bloom/index.d.cts"
      },
      "import": "./dist/bloom/index.js",
      "require": "./dist/bloom/index.cjs"
    },
    "./blocked": {
      "types": {
        "import": "./dist/blocked/index.d.ts",
        "require": "./dist/blocked/index.d.cts"
      },
      "import": "./dist/blocked/index.js",
      "require": "./dist/blocked/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "publint": "publint --strict",
    "check": "publint --strict && attw --pack . --profile node16",
    "attw": "attw --pack . --profile node16",
    "test": "vitest run",
    "bench": "tsx bench/core.bench.ts && tsx bench/bloom.bench.ts && tsx bench/blocked.bench.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "mitata": "^1.0.34",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}

---
import { MAX_KEYS, PROBE_COUNT } from "./engine.js";

const STRUCTURES = [
  { key: "bloom", label: "Classic Bloom", subpath: "distillate/bloom" },
  { key: "blocked", label: "Blocked Bloom", subpath: "distillate/blocked" },
  { key: "fuse8", label: "Binary Fuse 8", subpath: "distillate/fuse" },
] as const;

const bound = MAX_KEYS.toLocaleString("en-US");
const probes = PROBE_COUNT.toLocaleString("en-US");
---

<noscript>
  <style>
    [data-pg],
    [data-pg-add],
    [data-pg-query],
    [data-pg-status],
    [data-pg-results],
    [data-pg-notes] {
      display: none;
    }
  </style>
  <p>
    The playground builds real filters in your browser and needs JavaScript.
    With it off, <a href="/guides/choosing-a-structure/">Choosing a structure</a
    > covers the same ground in prose.
  </p>
</noscript>

<form class="dstl-form-grid" data-pg novalidate>
  <div class="dstl-field">
    <label for="pg-keys">Keys to insert</label>
    <input
      id="pg-keys"
      name="keys"
      type="text"
      inputmode="numeric"
      value="10000"
    />
    <p class="dstl-hint">
      Up to {bound}. Past that the playground refuses rather than freeze the
      tab.
    </p>
  </div>
  <div class="dstl-field">
    <label for="pg-target">Target false positive rate</label>
    <input
      id="pg-target"
      name="target"
      type="text"
      inputmode="decimal"
      value="0.01"
    />
    <p class="dstl-hint">
      Binary Fuse ignores this; its rate is fixed by fingerprint width.
    </p>
  </div>
  <button class="dstl-btn" type="submit">Build</button>
</form>

<form class="dstl-form-stack" data-pg-query novalidate>
  <div class="dstl-field">
    <label for="pg-query">Query a key</label>
    <input id="pg-query" name="key" type="text" value="key-5" />
    <p class="dstl-hint">
      Inserted keys are <code>key-0</code> through <code>key-9999</code>. Try
      <code>miss-22</code>, which none of them ever saw.
    </p>
  </div>
  <button class="dstl-btn" type="submit">Query</button>
</form>

<form class="dstl-form-stack" data-pg-add novalidate>
  <div class="dstl-field">
    <label for="pg-add">Add a key after the build</label>
    <input id="pg-add" name="key" type="text" value="late-key" />
    <p class="dstl-hint">
      Both Bloom filters take it. Binary Fuse is static and cannot, which is the
      trade it makes for its size.
    </p>
  </div>
  <button class="dstl-btn" type="submit">Add</button>
</form>

<div class="dstl-status" data-pg-status role="status" aria-live="polite"></div>

<table class="dstl-table" data-pg-results>
  <thead>
    <tr>
      <th>Structure</th>
      <th>Keys held</th>
      <th>Not found</th>
      <th>Bits/key</th>
      <th>Size</th>
      <th>Measured rate</th>
      <th>Last query</th>
    </tr>
  </thead>
  <tbody>
    {
      STRUCTURES.map((s) => (
        <tr data-row={s.key}>
          <th scope="row">
            {s.label}
            <span class="dstl-subpath">{s.subpath}</span>
          </th>
          <td data-cell="held" />
          <td data-cell="missing" />
          <td data-cell="bits" />
          <td data-cell="size" />
          <td data-cell="fpr" />
          <td data-cell="verdict" />
        </tr>
      ))
    }
  </tbody>
</table>

<div data-pg-notes>
  <p class="dstl-hint">
    <strong>A false positive is the filter working, not a bug.</strong> These structures
    trade exactness for space: a key that was never inserted can still answer yes,
    at roughly the target rate. What they never do is the reverse.
  </p>

  <p class="dstl-hint">
    <strong>Not found is zero, and stays zero.</strong> That column counts inserted
    keys the filter cannot find. It is guaranteed to be zero by how these structures
    are built, not a lucky property of this sample: a key that was added always answers
    yes. The measured rate is the false positive rate, checked over {probes} keys
    that were never inserted; it is an estimate, so expect it within roughly a factor
    of two of the target at these sample sizes. Binary Fuse ignores the target entirely,
    so its rate is not compared against one.
  </p>
</div>

<script>
  import { Playground } from "./engine.js";
  import type { PlaygroundReport, StructureKey } from "./engine.js";

  const KEYS = ["bloom", "blocked", "fuse8"] as const;

  function formatBytes(bytes: number): string {
    const units = ["bytes", "KiB", "MiB", "GiB"];
    let value = bytes;
    let unit = 0;
    while (value >= 1024 && unit < units.length - 1) {
      value /= 1024;
      unit += 1;
    }
    return unit === 0
      ? `${String(bytes)} bytes`
      : `${value.toFixed(1)} ${units[unit]}`;
  }

  const form = document.querySelector<HTMLFormElement>("[data-pg]");
  const queryForm = document.querySelector<HTMLFormElement>("[data-pg-query]");
  const addForm = document.querySelector<HTMLFormElement>("[data-pg-add]");
  const status = document.querySelector<HTMLElement>("[data-pg-status]");

  // Held between events. `report()` walks every key it holds, so a query must
  // read this rather than rebuild.
  let current: Playground | null = null;

  function cell(key: StructureKey, name: string): Element | null {
    return document.querySelector(`[data-row='${key}'] [data-cell='${name}']`);
  }

  function set(key: StructureKey, name: string, text: string): void {
    const el = cell(key, name);
    if (el) el.textContent = text;
  }

  function formatPercent(rate: number): string {
    return `${(rate * 100).toFixed(3)}%`;
  }

  // Anything that changes the key set invalidates the last query, so the
  // verdict column is cleared here rather than by each caller.
  function render(report: PlaygroundReport): void {
    for (const key of KEYS) {
      const s = report.structures[key];
      set(key, "held", s.heldKeys.toLocaleString("en-US"));
      set(key, "missing", String(s.missing));
      set(key, "bits", s.bitsPerKey.toFixed(2));
      set(key, "size", formatBytes(s.totalBytes));
      set(key, "fpr", formatPercent(s.measuredFpr));
      set(key, "verdict", "");
    }
  }

  function build(): void {
    if (!form) return;
    const data = new FormData(form);
    const result = Playground.build(data.get("keys"), data.get("target"));
    if (!result.ok) {
      if (status) status.textContent = result.message;
      return;
    }
    if (status) status.textContent = "";
    current = result.playground;
    render(current.report());
  }

  function insert(): void {
    if (!addForm || !current) return;
    const key = String(new FormData(addForm).get("key") ?? "");
    if (key === "") return;
    const { fuseRefusal } = current.insert(key);
    if (status) status.textContent = fuseRefusal;
    render(current.report());
  }

  function query(): void {
    if (!queryForm || !current) return;
    const key = String(new FormData(queryForm).get("key") ?? "");
    const { verdicts } = current.lookup(key);
    for (const structure of KEYS)
      set(structure, "verdict", verdicts[structure]);
  }

  function onSubmit(target: HTMLFormElement | null, run: () => void): void {
    target?.addEventListener("submit", (event) => {
      event.preventDefault();
      run();
    });
  }

  onSubmit(form, build);
  onSubmit(queryForm, query);
  onSubmit(addForm, insert);
  build();
</script>

---
const STRUCTURES = [
  { key: "bloom", label: "Classic Bloom", subpath: "distillate/bloom" },
  { key: "blocked", label: "Blocked Bloom", subpath: "distillate/blocked" },
  { key: "fuse8", label: "Binary Fuse 8", subpath: "distillate/fuse" },
  { key: "fuse16", label: "Binary Fuse 16", subpath: "distillate/fuse" },
] as const;
---

<noscript>
  <style>
    [data-sizing],
    [data-sizing-results],
    [data-sizing-warnings] {
      display: none;
    }
  </style>
  <p class="dstl-hint">
    The calculator runs in your browser and needs JavaScript. With it off, the
    tables in <a href="/guides/sizing/">Sizing and tuning FPR</a> give bits per key
    for classic Bloom at every common target, the blocked equivalents, and both fuse
    widths.
  </p>
</noscript>

<form class="dstl-form-grid" data-sizing novalidate>
  <div class="dstl-field">
    <label for="sizing-capacity">Capacity (distinct keys)</label>
    <input
      id="sizing-capacity"
      name="capacity"
      type="text"
      inputmode="numeric"
      value="1,000,000"
    />
  </div>
  <div class="dstl-field">
    <label for="sizing-epsilon">Target false positive rate</label>
    <input
      id="sizing-epsilon"
      name="epsilon"
      type="text"
      inputmode="decimal"
      value="0.01"
    />
    <p class="dstl-hint">
      1e-2 is 1%. Binary Fuse ignores this; its rate is fixed by fingerprint
      width.
    </p>
  </div>
</form>

<div class="dstl-status" data-sizing-warnings role="status" aria-live="polite">
</div>

<table class="dstl-table" data-sizing-results>
  <thead>
    <tr><th>Structure</th><th>Bits/key</th><th>Total size</th></tr>
  </thead>
  <tbody>
    {
      STRUCTURES.map((s) => (
        <tr data-row={s.key}>
          <th scope="row">
            {s.label}
            <span class="dstl-subpath">{s.subpath}</span>
          </th>
          <td data-cell="bits" colspan="2">
            Calculating…
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .failed {
    color: var(--sl-color-gray-3);
  }
</style>

<script>
  import { computeSizing } from "./compute.js";
  import type { StructureResult } from "./compute.js";

  const KEYS = ["bloom", "blocked", "fuse8", "fuse16"] as const;

  function formatBytes(bytes: number): string {
    const units = ["bytes", "KiB", "MiB", "GiB", "TiB"];
    let value = bytes;
    let unit = 0;
    while (value >= 1024 && unit < units.length - 1) {
      value /= 1024;
      unit += 1;
    }
    const scaled =
      unit === 0 ? String(bytes) : `${value.toFixed(2)} ${units[unit]}`;
    return unit === 0
      ? `${scaled} bytes`
      : `${scaled} (${bytes.toLocaleString()} bytes)`;
  }

  function render(row: HTMLTableRowElement, result: StructureResult): void {
    const cell = row.querySelector<HTMLTableCellElement>("[data-cell='bits']");
    if (!cell) return;
    if (!result.ok) {
      cell.colSpan = 2;
      cell.className = "failed";
      cell.textContent = result.message;
      return;
    }
    cell.colSpan = 1;
    cell.className = "";
    cell.textContent = `${result.bitsPerKey.toFixed(2)}`;
    let size = row.querySelector<HTMLTableCellElement>("[data-cell='size']");
    if (!size) {
      size = document.createElement("td");
      size.dataset.cell = "size";
      row.append(size);
    }
    size.textContent = formatBytes(result.totalBytes);
    size.title = result.note ?? "";
  }

  // Only regroup input that is already just digits and separators, so typing
  // something wrong is left intact for the validation message to explain.
  const GROUPED = /^[\d,]*$/;
  const MAX_DIGITS = 15;

  function digitsOf(value: string): string {
    return value.replace(/\D/g, "");
  }

  // Regroups in place, keeping the caret where the typist left it. The offset
  // is counted in digits rather than characters, so an inserted comma does not
  // drag the caret along with it.
  function regroup(input: HTMLInputElement): void {
    if (!GROUPED.test(input.value)) return;
    const digits = digitsOf(input.value);
    if (digits === "" || digits.length > MAX_DIGITS) return;

    const caret = input.selectionStart ?? input.value.length;
    const digitsBeforeCaret = digitsOf(input.value.slice(0, caret)).length;
    const formatted = Number(digits).toLocaleString("en-US");
    if (formatted === input.value) return;

    input.value = formatted;
    let seen = 0;
    let position = 0;
    while (position < formatted.length && seen < digitsBeforeCaret) {
      if (/\d/.test(formatted.charAt(position))) seen += 1;
      position += 1;
    }
    input.setSelectionRange(position, position);
  }

  const capacityInput =
    document.querySelector<HTMLInputElement>("#sizing-capacity");
  const form = document.querySelector<HTMLFormElement>("[data-sizing]");
  const warnings = document.querySelector<HTMLElement>(
    "[data-sizing-warnings]",
  );

  function update(): void {
    if (!form) return;
    const data = new FormData(form);
    const raw = String(data.get("capacity") ?? "");
    const capacity = GROUPED.test(raw) ? digitsOf(raw) : raw;
    const report = computeSizing(capacity, data.get("epsilon"));
    for (const key of KEYS) {
      const row = document.querySelector<HTMLTableRowElement>(
        `[data-row='${key}']`,
      );
      if (row) render(row, report[key]);
    }
    if (warnings) warnings.textContent = report.warnings.join(" ");
  }

  form?.addEventListener("input", (event) => {
    if (capacityInput && event.target === capacityInput) regroup(capacityInput);
    update();
  });
  update();
</script>

{
  "name": "distillate-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Documentation site for distillate, built with Astro and Starlight",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "test": "vitest run",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "links:check": "node scripts/check-links.mjs dist ../.."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.8",
    "distillate": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@distillate/hyperloglog": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "starlight-typedoc": "^0.23.2",
    "tailwindcss": "^4.3.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
